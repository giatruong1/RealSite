{
  "manifest_version": 3,
  "name": "RealSite",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "RealSite: checking every site you open",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "version": "1.0.0",
  "description": "Warns before you land on a fake lookalike of a well-known site (go0gle.com instead of google.com).",
  "permissions": ["webNavigation", "storage", "history"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": { "id": "lookalike-guard@local", "strict_min_version": "121.0" }
  }
}
